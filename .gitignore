# vim:syntax=sh
# vim:filetype=sh

# This template file isn't needed, once config is done.  Remove it and
# then you can remove this entry as well, if you'd like
INSTRUCTIONS.template

# Prevent the commit of analysis products
*.npy
*.gz
*.pb


# Build products
*.o
*.a

# Some annoying Apple stuff
.DS_Store
*.dSYM

# Python stuff
*.pyc
*.egg
*.eggs
*.egg-info
__pycache__
.pytest_cache
.src
.cache
.ropeproject
*.pkl
!test/data/spin_injections.pkl
!test/data/processed_pulsar_data.pkl
!workflows/example_workflow_lite/data_files/approximate_spin_injections.pkl

# Virtual env stuff
venv
.venv

# Pyenv stuff
.python-version

# Poetry stuff
dist
poetry.toml

# JetBrains stuff
.idea

# .vi swap files
*.*.swp

# tag files
.tags

# cmake stuff
.cmake-tmp*

# Common names for out-of-source build directories
cmake-build-*
build-*
build
_build

# Scratch directories/files
.tests
.project_aux.json

#Miscillaneous
.install*
*.old
.ipynb_checkpoints
local
htmlcov
.coverage
*.log

# MkDocs build output
site/

# Workflow outputs
workflows/**/outputs/

# NG15 SGWB demo: ignore large ingested/aligned/injected feathers, keep small JSON configs
workflows/ng15_sgwb_demo/data/**/*.feather
# Staged par/tim symlinks point to machine-specific cluster paths (regenerate with stage_symlinks.py)
workflows/ng15_sgwb_demo/data/staging_subset/
workflows/ng15_sgwb_demo/data/staging_full/
# M1 MDC2 per-pulsar staging (symlinks; regenerate with stage_mdc2.py)
workflows/ng15_sgwb_demo/data/mdc2_singles/
workflows/ng15_sgwb_demo/data/mdc2_all
# M1 Stage A artifacts ARE tracked (small; inputs to Stages B/C) — *.pkl is
# globally ignored above, so whitelist the medians pickle explicitly
!workflows/ng15_sgwb_demo/data/stage_a_medians.pkl

# Exploratory work (kept locally, not tracked)
archive/
workflows/cw_*/
workflows/legacy/

# IPTA Mock Data Challenge data files (downloaded separately)
workflows/data/IPTA_MockDataChallenge2/dataset_*/

# Claude stuff
.claude
CLAUDE.md
handoff.md